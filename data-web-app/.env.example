# Application Configuration
APP_NAME="Data Web Application"
APP_VERSION="1.0.0"
APP_DEBUG=True
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_SECRET_KEY="change-me-in-production"

# Data Source Configuration
# Possible values: 'csv' or 'postgres'
DATA_SOURCE=csv

# CSV Configuration
CSV_DIRECTORY=./data/csv
UPLOAD_DIRECTORY=./data/uploads
MAX_FILE_SIZE_MB=10

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=data_app
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# For production, use these settings:
# APP_DEBUG=False
# DATA_SOURCE=postgres
# DB_HOST=data-web-app-postgres  # Kubernetes service name
