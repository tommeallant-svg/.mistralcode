   Maps
   ============================================ */
.map-container {
    position: relative;
    height: 500px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--gray-100);
}

.map-container .map {
    width: 100%;
    height: 100%;
}
=======
/* ============================================
   Maps
   ============================================ */
.map-container {
    position: relative;
    height: 500px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--gray-100);
}

.map-container .map {
    width: 100%;
    height: 100%;
}

.modal-map {
    height: 300px;
    border-radius: var(--radius-md);
    border: 1px solid var(--gray-300);
    margin-top: var(--spacing-sm);
    background: var(--gray-100);
}

.modal-map .map {
    width: 100%;
    height: 100%;
}============================================
   Road - Travel Management Application
   Station F Vibe Design
   ============================================ */

/* CSS Variables */
:root {
    /* Colors - Station F Vibe (Modern Tech Startup) */
    --primary: #4F46E5;
    --primary-dark: #4338CA;
    --primary-light: #818CF8;
    --primary-lighter: #C7D2FE;
    --primary-bg: #EEF2FF;
    
    --secondary: #6366F1;
    --secondary-dark: #5856EB;
    
    --success: #10B981;
    --success-dark: #059669;
    --success-light: #D1FAE5;
    --success-bg: #ECFDF5;
    
    --warning: #F59E0B;
    --warning-dark: #D97706;
    --warning-light: #FEF3C7;
    --warning-bg: #FFFBEB;
    
    --danger: #EF4444;
    --danger-dark: #DC2626;
    --danger-light: #FEE2E2;
    --danger-bg: #FEF2F2;
    
    --info: #3B82F6;
    --info-dark: #2563EB;
    --info-light: #93C5FD;
    --info-bg: #EFF6FF;
    
    /* Category Colors */
    --category-transport: #3B82F6;
    --category-accommodation: #10B981;
    --category-activity: #F59E0B;
    --category-food: #EF4444;
    --category-sport: #8B5CF6;
    --category-hobbies: #EC4899;
    
    /* Neutral Colors */
    --white: #FFFFFF;
    --black: #000000;
    --gray-50: #F9FAFB;
    --gray-100: #F3F4F6;
    --gray-200: #E5E7EB;
    --gray-300: #D1D5DB;
    --gray-400: #9CA3AF;
    --gray-500: #6B7280;
    --gray-600: #4B5563;
    --gray-700: #374151;
    --gray-800: #1F2937;
    --gray-900: #111827;
    
    /* Typography */
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-size-xs: 0.75rem;
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-lg: 1.125rem;
    --font-size-xl: 1.25rem;
    --font-size-2xl: 1.5rem;
    --font-size-3xl: 2rem;
    
    /* Spacing */
    --spacing-xs: 0.25rem;
    --spacing-sm: 0.5rem;
    --spacing-md: 1rem;
    --spacing-lg: 1.5rem;
    --spacing-xl: 2rem;
    --spacing-2xl: 3rem;
    
    /* Border Radius */
    --radius-sm: 0.25rem;
    --radius-md: 0.375rem;
    --radius-lg: 0.5rem;
    --radius-xl: 0.75rem;
    --radius-2xl: 1rem;
    --radius-full: 9999px;
    
    /* Shadows */
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    
    /* Transitions */
    --transition-fast: 150ms ease;
    --transition: 200ms ease;
    --transition-slow: 300ms ease;
    
    /* Layout */
    --header-height: 64px;
    --sidebar-width: 250px;
    --sidebar-collapsed-width: 64px;
}

/* Reset & Base */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

body {
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: var(--gray-800);
    background-color: var(--gray-50);
}

a {
    color: var(--primary);
    text-decoration: none;
}

a:hover {
    color: var(--primary-dark);
}

button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: none;
}

input, select, textarea {
    font-family: inherit;
    font-size: inherit;
}

img {
    max-width: 100%;
}

/* ============================================
   Auth Screens
   ============================================ */
.auth-screen {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    padding: var(--spacing-lg);
}

.auth-container {
    width: 100%;
    max-width: 400px;
}

.auth-card {
    background: var(--white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    padding: var(--spacing-2xl);
    text-align: center;
}

.auth-card .logo-container {
    margin-bottom: var(--spacing-xl);
}

.auth-card .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--primary);
}

.auth-card .logo i {
    font-size: var(--font-size-3xl);
}

.auth-card h1 {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--gray-900);
    margin-bottom: var(--spacing-sm);
}

.auth-card p {
    color: var(--gray-600);
    margin-bottom: var(--spacing-xl);
}

.form-group {
    margin-bottom: var(--spacing-lg);
    text-align: left;
}

.form-group label {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--gray-700);
    margin-bottom: var(--spacing-sm);
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--gray-800);
    transition: border-color var(--transition), box-shadow var(--transition);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
}

.form-group input::placeholder {
    color: var(--gray-400);
}

.auth-card .btn {
    width: 100%;
    padding: var(--spacing-md) var(--spacing-lg);
    font-size: var(--font-size-base);
    font-weight: 500;
    border-radius: var(--radius-md);
    transition: all var(--transition);
}

.auth-card .btn-primary {
    background: var(--primary);
    color: var(--white);
}

.auth-card .btn-primary:hover {
    background: var(--primary-dark);
}

.auth-card .btn-primary:active {
    background: var(--primary-dark);
    transform: translateY(1px);
}

.error-message {
    color: var(--danger);
    font-size: var(--font-size-sm);
    margin-top: var(--spacing-md);
    min-height: 20px;
}

.demo-info {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--gray-200);
    color: var(--gray-500);
}

/* ============================================
   Main App Layout
   ============================================ */
#app {
    min-height: 100vh;
    display: flex;
}

.hidden {
    display: none !important;
}

/* Header */
.header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    background: var(--white);
    border-bottom: 1px solid var(--gray-200);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--spacing-lg);
    z-index: 100;
    transition: left var(--transition);
}

.header-left {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
}

.header .logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--primary);
}

.header .logo i {
    font-size: var(--font-size-2xl);
}

.back-button {
    padding: var(--spacing-xs);
    border-radius: var(--radius-md);
    color: var(--gray-600);
    transition: all var(--transition);
}

.back-button:hover {
    background: var(--gray-100);
    color: var(--primary);
}

.menu-toggle {
    padding: var(--spacing-xs);
    border-radius: var(--radius-md);
    color: var(--gray-600);
    transition: all var(--transition);
}

.menu-toggle:hover {
    background: var(--gray-100);
    color: var(--primary);
}

.header-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
}

.header-center #current-view-title {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--gray-800);
}

.header-right {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
}

.user-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--font-size-sm);
    color: var(--gray-600);
}

.user-info i {
    font-size: var(--font-size-lg);
}

.btn-icon {
    padding: var(--spacing-xs);
    border-radius: var(--radius-md);
    color: var(--gray-600);
    transition: all var(--transition);
}

.btn-icon:hover {
    background: var(--gray-100);
    color: var(--danger);
}

/* Sidebar */
.sidebar {
    position: fixed;
    top: var(--header-height);
    left: 0;
    bottom: 0;
    width: var(--sidebar-width);
    background: var(--white);
    border-right: 1px solid var(--gray-200);
    display: flex;
    flex-direction: column;
    z-index: 99;
    transition: all var(--transition);
}

.sidebar.collapsed {
    width: var(--sidebar-collapsed-width);
}

.sidebar-header {
    padding: var(--spacing-lg);
    border-bottom: 1px solid var(--gray-200);
}

.sidebar-header .logo {
    justify-content: center;
}

.sidebar.collapsed .sidebar-header .logo span {
    display: none;
}

.sidebar-nav {
    flex: 1;
    padding: var(--spacing-lg) var(--spacing-sm);
    overflow-y: auto;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-md);
    color: var(--gray-600);
    font-size: var(--font-size-sm);
    font-weight: 500;
    margin-bottom: var(--spacing-xs);
    transition: all var(--transition);
}

.nav-item:hover {
    background: var(--gray-100);
    color: var(--primary);
}

.nav-item.active {
    background: var(--primary-bg);
    color: var(--primary);
}

.nav-item i {
    width: 20px;
    text-align: center;
}

.sidebar.collapsed .nav-item span {
    display: none;
}

.sidebar.collapsed .nav-item {
    justify-content: center;
    padding: var(--spacing-sm);
}

.sidebar-footer {
    padding: var(--spacing-lg);
    border-top: 1px solid var(--gray-200);
}

.sidebar-footer .user-info {
    justify-content: center;
}

.sidebar.collapsed .sidebar-footer .user-info span {
    display: none;
}

/* Main Content */
.main-content {
    flex: 1;
    margin-left: var(--sidebar-width);
    padding-top: var(--header-height);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    transition: margin-left var(--transition);
}

.sidebar.collapsed ~ .main-content {
    margin-left: var(--sidebar-collapsed-width);
}

/* Views */
.view {
    flex: 1;
    padding: var(--spacing-xl);
    overflow-y: auto;
}

.view-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-xl);
    flex-wrap: wrap;
    gap: var(--spacing-md);
}

.view-header h1 {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--gray-900);
}

.view-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.view-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.view-breadcrumb button {
    padding: var(--spacing-xs);
    border-radius: var(--radius-md);
    color: var(--gray-600);
    transition: all var(--transition);
}

.view-breadcrumb button:hover {
    background: var(--gray-100);
    color: var(--primary);
}

.view-breadcrumb span {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--gray-800);
}

/* ============================================
   Buttons
   ============================================ */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: var(--font-size-sm);
    font-weight: 500;
    border-radius: var(--radius-md);
    transition: all var(--transition);
    white-space: nowrap;
}

.btn-primary {
    background: var(--primary);
    color: var(--white);
}

.btn-primary:hover {
    background: var(--primary-dark);
}

.btn-secondary {
    background: var(--white);
    color: var(--gray-700);
    border: 1px solid var(--gray-300);
}

.btn-secondary:hover {
    background: var(--gray-50);
    border-color: var(--gray-400);
}

.btn-danger {
    background: var(--danger);
    color: var(--white);
}

.btn-danger:hover {
    background: var(--danger-dark);
}

.btn-success {
    background: var(--success);
    color: var(--white);
}

.btn-success:hover {
    background: var(--success-dark);
}

.btn-warning {
    background: var(--warning);
    color: var(--white);
}

.btn-warning:hover {
    background: var(--warning-dark);
}

.btn-info {
    background: var(--info);
    color: var(--white);
}

.btn-info:hover {
    background: var(--info-dark);
}

.btn-block {
    width: 100%;
}

.btn-sm {
    padding: var(--spacing-xs) var(--spacing-sm);
    font-size: var(--font-size-xs);
}

.btn-lg {
    padding: var(--spacing-md) var(--spacing-xl);
    font-size: var(--font-size-base);
}

.btn-icon {
    padding: var(--spacing-xs);
    border-radius: var(--radius-md);
    color: var(--gray-600);
    transition: all var(--transition);
}

.btn-icon:hover {
    background: var(--gray-100);
}

/* ============================================
   Tables
   ============================================ */
.table-container {
    background: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--gray-200);
    overflow: hidden;
    margin-bottom: var(--spacing-xl);
}

.data-table {
    width: 100%;
    border-collapse: collapse;
}

.data-table th,
.data-table td {
    padding: var(--spacing-md) var(--spacing-lg);
    text-align: left;
    border-bottom: 1px solid var(--gray-200);
}

.data-table th {
    background: var(--gray-50);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--gray-600);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.data-table tbody tr:hover {
    background: var(--gray-50);
}

.data-table tbody tr:last-child td {
    border-bottom: none;
}

.data-table .category-cell {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
}

.category-indicator {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
}

.category-transport { background: var(--category-transport); }
.category-accommodation { background: var(--category-accommodation); }
.category-activity { background: var(--category-activity); }
.category-food { background: var(--category-food); }
.category-sport { background: var(--category-sport); }
.category-hobbies { background: var(--category-hobbies); }

/* ============================================
   Cards
   ============================================ */
.card {
    background: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--gray-200);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
    box-shadow: var(--shadow-sm);
}

.card-header {
    margin-bottom: var(--spacing-lg);
}

.card-header h2 {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--gray-900);
}

.card-body {
    color: var(--gray-700);
}

/* Trip Info Card */
.trip-info-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--gray-200);
    padding: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
    box-shadow: var(--shadow-sm);
}

.trip-info-header {
    margin-bottom: var(--spacing-lg);
}

.trip-status-badge {
    display: inline-block;
    margin-bottom: var(--spacing-sm);
}

.badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.badge-draft {
    background: var(--warning-bg);
    color: var(--warning-dark);
}

.badge-validated {
    background: var(--success-bg);
    color: var(--success-dark);
}

.trip-info-header h1 {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--gray-900);
    margin-bottom: var(--spacing-sm);
}

.trip-dates {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--font-size-sm);
    color: var(--gray-600);
    margin-bottom: var(--spacing-sm);
}

.trip-dates i {
    color: var(--primary);
}

.trip-description {
    font-size: var(--font-size-base);
    color: var(--gray-700);
    line-height: 1.6;
}

.trip-info-body {}

.trip-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
}

.stat-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--font-size-sm);
    color: var(--gray-600);
}

.stat-item i {
    color: var(--primary);
    width: 16px;
}

/* ============================================
   Filters
   ============================================ */
.filters-panel {
    background: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--gray-200);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
    box-shadow: var(--shadow-sm);
}

.filter-group {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
}

.filter-group label {
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--gray-700);
    white-space: nowrap;
}

.filter-group select,
.filter-group input {
    flex: 1;
    max-width: 200px;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--gray-800);
    font-size: var(--font-size-sm);
}

.filter-group select:focus,
.filter-group input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
}

.filter-actions {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: flex-end;
}

/* Step Filters */
.step-filters {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-lg);
    flex-wrap: wrap;
    gap: var(--spacing-md);
}

.filter-tabs {
    display: flex;
    gap: var(--spacing-xs);
    overflow-x: auto;
    padding-bottom: var(--spacing-xs);
}

.filter-tab {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--gray-600);
    background: var(--white);
    border: 1px solid var(--gray-300);
    white-space: nowrap;
    transition: all var(--transition);
}

.filter-tab:hover {
    border-color: var(--primary);
    color: var(--primary);
}

.filter-tab.active {
    background: var(--primary);
    color: var(--white);
    border-color: var(--primary);
}

.filter-tab i {
    font-size: var(--font-size-sm);
}

.step-filter-actions {}

/* ============================================
   Empty States
   ============================================ */
.empty-state {
    text-align: center;
    padding: var(--spacing-2xl) var(--spacing-xl);
    color: var(--gray-500);
}

.empty-state i {
    font-size: var(--font-size-3xl);
    color: var(--gray-300);
    margin-bottom: var(--spacing-lg);
}

.empty-state h3 {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--gray-700);
    margin-bottom: var(--spacing-sm);
}

.empty-state p {
    color: var(--gray-500);
    margin-bottom: var(--spacing-xl);
}

/* ============================================
   Maps
   ============================================ */
.map-container {
    position: relative;
    height: 500px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--gray-100);
}

.map-container .map {
    width: 100%;
    height: 100%;
}

/* ============================================
   AI Chat Section
   ============================================ */
.ai-chat-section {
    background: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--gray-200);
    padding: var(--spacing-xl);
    margin-top: var(--spacing-xl);
    box-shadow: var(--shadow-sm);
}

.ai-chat-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--gray-200);
}

.ai-avatar {
    width: 48px;
    height: 48px;
    background: var(--primary-bg);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    font-size: var(--font-size-xl);
}

.ai-avatar.small {
    width: 32px;
    height: 32px;
    font-size: var(--font-size-base);
}

.ai-info h3 {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--gray-900);
}

.ai-info p {
    font-size: var(--font-size-sm);
    color: var(--gray-500);
}

.ai-chat-messages {
    height: 300px;
    overflow-y: auto;
    margin-bottom: var(--spacing-lg);
    padding-right: var(--spacing-sm);
}

.ai-chat-messages::-webkit-scrollbar {
    width: 6px;
}

.ai-chat-messages::-webkit-scrollbar-track {
    background: var(--gray-100);
    border-radius: var(--radius-full);
}

.ai-chat-messages::-webkit-scrollbar-thumb {
    background: var(--gray-300);
    border-radius: var(--radius-full);
}

.ai-chat-messages::-webkit-scrollbar-thumb:hover {
    background: var(--gray-400);
}

.message {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
}

.message.user {
    justify-content: flex-end;
}

.message.user .message-content {
    background: var(--primary);
    color: var(--white);
    border-radius: var(--radius-lg) var(--radius-lg) 0 var(--radius-lg);
}

.message.assistant .message-content {
    background: var(--gray-100);
    color: var(--gray-800);
    border-radius: var(--radius-lg) var(--radius-lg) var(--radius-lg) 0;
}

.message-content {
    max-width: 80%;
    padding: var(--spacing-md);
    border-radius: var(--radius-lg);
    font-size: var(--font-size-sm);
    line-height: 1.5;
}

.ai-welcome-message {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
}

.ai-welcome-message .message-content {
    background: var(--gray-100);
    color: var(--gray-800);
    padding: var(--spacing-md);
    border-radius: var(--radius-lg);
    max-width: 80%;
}

.ai-welcome-message .message-content p {
    font-size: var(--font-size-sm);
    line-height: 1.5;
}

.ai-welcome-message .message-content p:first-child {
    margin-bottom: var(--spacing-sm);
}

.ai-welcome-message .message-content small {
    color: var(--gray-500);
    font-size: var(--font-size-xs);
}

.ai-chat-input {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    border-top: 1px solid var(--gray-200);
    padding-top: var(--spacing-lg);
}

.ai-chat-input input {
    flex: 1;
    padding: var(--spacing-md);
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-lg);
    font-size: var(--font-size-sm);
    color: var(--gray-800);
    transition: border-color var(--transition), box-shadow var(--transition);
}

.ai-chat-input input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
}

.ai-chat-input input::placeholder {
    color: var(--gray-400);
}

.ai-chat-input button {
    padding: var(--spacing-md);
    background: var(--primary);
    color: var(--white);
    border-radius: var(--radius-lg);
    transition: background var(--transition);
}

.ai-chat-input button:hover {
    background: var(--primary-dark);
}

/* AI Suggestions */
.ai-suggestions {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--gray-200);
}

.ai-suggestions h4 {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--gray-700);
    margin-bottom: var(--spacing-md);
}

.suggestions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--spacing-md);
}

.suggestion-card {
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    cursor: pointer;
    transition: all var(--transition);
}

.suggestion-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
}

.suggestion-card h5 {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--gray-800);
    margin-bottom: var(--spacing-xs);
}

.suggestion-card p {
    font-size: var(--font-size-xs);
    color: var(--gray-500);
    margin-bottom: var(--spacing-xs);
}

.suggestion-card .suggestion-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--font-size-xs);
    color: var(--gray-400);
}

/* ============================================
   Modals
   ============================================ */
.modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
}

.modal-content {
    position: relative;
    background: var(--white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    width: 90%;
    max-width: 600px;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-content.modal-sm {
    max-width: 400px;
}

.modal-content.modal-lg {
    max-width: 900px;
    max-height: 90vh;
}

.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-lg);
    border-bottom: 1px solid var(--gray-200);
    position: sticky;
    top: 0;
    background: var(--white);
    z-index: 10;
}

.modal-header h2 {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--gray-900);
}

.modal-close {
    padding: var(--spacing-xs);
    border-radius: var(--radius-md);
    color: var(--gray-500);
    transition: all var(--transition);
}

.modal-close:hover {
    background: var(--gray-100);
    color: var(--danger);
}

.modal-body {
    padding: var(--spacing-lg);
}

.modal-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-sm);
    padding: var(--spacing-lg);
    border-top: 1px solid var(--gray-200);
    background: var(--gray-50);
}

.modal-body .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
}

.modal-body .form-group {
    margin-bottom: 0;
}

.modal-body .form-group label {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--gray-700);
    margin-bottom: var(--spacing-xs);
}

.modal-body .form-group input,
.modal-body .form-group select,
.modal-body .form-group textarea {
    width: 100%;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--gray-800);
    font-size: var(--font-size-sm);
    transition: border-color var(--transition), box-shadow var(--transition);
}

.modal-body .form-group input:focus,
.modal-body .form-group select:focus,
.modal-body .form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
}

.modal-body .form-group input::placeholder {
    color: var(--gray-400);
}

.modal-body .form-group textarea {
    resize: vertical;
    min-height: 80px;
}

/* ============================================
   Form Elements
   ============================================ */
.form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
}

.form-group {
    margin-bottom: var(--spacing-md);
}

.form-group label {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--gray-700);
    margin-bottom: var(--spacing-xs);
}

.form-group input[type="text"],
.form-group input[type="password"],
.form-group input[type="email"],
.form-group input[type="number"],
.form-group input[type="datetime-local"],
.form-group input[type="color"],
.form-group select,
.form-group textarea {
    width: 100%;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--gray-800);
    font-size: var(--font-size-sm);
    transition: border-color var(--transition), box-shadow var(--transition);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-bg);
}

.form-group input::placeholder {
    color: var(--gray-400);
}

.form-group input[type="color"] {
    height: 40px;
    padding: var(--spacing-xs);
}

.form-group textarea {
    resize: vertical;
    min-height: 80px;
}

.form-group input[type="datetime-local"] {
    height: 40px;
}

/* ============================================
   Toast Notifications
   ============================================ */
.toast-container {
    position: fixed;
    top: var(--spacing-xl);
    right: var(--spacing-xl);
    z-index: 2000;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
}

.toast {
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--spacing-md) var(--spacing-lg);
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    animation: slideIn 0.3s ease;
}

.toast.success {
    border-left: 4px solid var(--success);
}

.toast.error {
    border-left: 4px solid var(--danger);
}

.toast.info {
    border-left: 4px solid var(--info);
}

.toast.warning {
    border-left: 4px solid var(--warning);
}

.toast i {
    font-size: var(--font-size-lg);
}

.toast.success i { color: var(--success); }
.toast.error i { color: var(--danger); }
.toast.info i { color: var(--info); }
.toast.warning i { color: var(--warning); }

.toast-message {
    flex: 1;
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--gray-800);
}

.toast-close {
    padding: var(--spacing-xs);
    color: var(--gray-400);
    cursor: pointer;
    transition: color var(--transition);
}

.toast-close:hover {
    color: var(--gray-600);
}

@keyframes slideIn {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

/* ============================================
   Loading Spinner
   ============================================ */
.loading-spinner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3000;
}

.loading-spinner .spinner {
    background: var(--white);
    border-radius: var(--radius-xl);
    padding: var(--spacing-xl);
    box-shadow: var(--shadow-xl);
}

.loading-spinner .spinner i {
    font-size: var(--font-size-3xl);
    color: var(--primary);
}

/* ============================================
   Action Buttons
   ============================================ */
.action-btn {
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-md);
    font-size: var(--font-size-xs);
    cursor: pointer;
    transition: all var(--transition);
}

.action-btn:hover {
    opacity: 0.8;
}

.action-btn.edit {
    color: var(--info);
}

.action-btn.delete {
    color: var(--danger);
}

.action-btn.duplicate {
    color: var(--success);
}

.action-btn.view {
    color: var(--primary);
}

.action-btn.share {
    color: var(--warning);
}

/* ============================================
   Trip List Container
   ============================================ */
.trip-list-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
}

@media (min-width: 1024px) {
    .trip-list-container {
        grid-template-columns: 1fr 1fr;
    }
    
    .trip-list-container .table-container {
        height: 500px;
        overflow-y: auto;
    }
    
    .trip-list-container .map-container {
        height: 500px;
    }
}

.trip-detail-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
}

@media (min-width: 1024px) {
    .trip-detail-main {
        grid-template-columns: 1fr;
    }
    
    .trip-detail-main .step-list-container {
        height: 400px;
        overflow-y: auto;
    }
    
    .trip-detail-main .map-container {
        height: 400px;
    }
}

/* ============================================
   Responsive Design
   ============================================ */
@media (max-width: 1024px) {
    .sidebar {
        transform: translateX(-100%);
    }
    
    .sidebar.expanded {
        transform: translateX(0);
    }
    
    .main-content {
        margin-left: 0;
    }
    
    .header .logo span {
        display: none;
    }
    
    .header-center {
        position: static;
        transform: none;
    }
    
    .header-center #current-view-title {
        font-size: var(--font-size-lg);
    }
    
    .header-right .user-info span {
        display: none;
    }
}

@media (min-width: 1200px) {
    .modal-content {
        max-width: 700px;
    }
    
    .modal-content.modal-lg {
        max-width: 1000px;
    }
}

@media (max-width: 768px) {
    .modal-map {
        height: 200px;
    }
    
    :root {
        --header-height: 56px;
    }
    
    .header {
        padding: 0 var(--spacing-md);
    }
    
    .header-left {
        gap: var(--spacing-sm);
    }
    
    .header-right {
        gap: var(--spacing-xs);
    }
    
    .view {
        padding: var(--spacing-lg);
    }
    
    .view-header {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .view-header h1 {
        font-size: var(--font-size-xl);
    }
    
    .view-actions {
        width: 100%;
        justify-content: flex-start;
    }
    
    .trip-list-container {
        grid-template-columns: 1fr;
    }
    
    .form-row {
        grid-template-columns: 1fr;
    }
    
    .modal-content {
        width: 95%;
        margin: var(--spacing-md);
    }
    
    .modal-content.modal-lg {
        width: 95%;
    }
    
    .step-filters {
        flex-direction: column;
    }
    
    .filter-tabs {
        width: 100%;
        justify-content: flex-start;
    }
    
    .ai-chat-messages {
        height: 200px;
    }
    
    .suggestions-grid {
        grid-template-columns: 1fr;
    }
    
    .trip-info-card {
        padding: var(--spacing-lg);
    }
    
    .trip-info-header h1 {
        font-size: var(--font-size-xl);
    }
    
    .trip-stats {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 480px) {
    .auth-card {
        padding: var(--spacing-xl);
    }
    
    .auth-card .logo {
        font-size: var(--font-size-xl);
    }
    
    .auth-card .logo i {
        font-size: var(--font-size-2xl);
    }
    
    .auth-card h1 {
        font-size: var(--font-size-lg);
    }
    
    .form-row {
        grid-template-columns: 1fr;
    }
    
    .filter-tab {
        padding: var(--spacing-xs);
        font-size: var(--font-size-xs);
    }
    
    .filter-tab span {
        display: none;
    }
    
    .data-table th,
    .data-table td {
        padding: var(--spacing-sm);
        font-size: var(--font-size-xs);
    }
    
    .btn {
        padding: var(--spacing-xs) var(--spacing-sm);
        font-size: var(--font-size-xs);
    }
}

/* ============================================
   Print Styles
   ============================================ */
@media print {
    .header,
    .sidebar,
    .modal,
    .loading-spinner,
    .toast-container,
    .ai-chat-section {
        display: none !important;
    }
    
    .main-content {
        margin: 0;
        padding: 0;
    }
    
    .view {
        padding: 0;
    }
}

/* ============================================
   Drag and Drop
   ============================================ */
.draggable {
    cursor: move;
}

.dragging {
    opacity: 0.5;
    background: var(--primary-bg);
}

.drop-target {
    background: var(--primary-bg);
    border-top: 2px solid var(--primary);
}

/* ============================================
   Sortable Table
   ============================================ */
.sortable-table {
    position: relative;
}

.sortable-handle {
    cursor: grab;
    padding: var(--spacing-xs);
    color: var(--gray-400);
}

.sortable-handle:hover {
    color: var(--primary);
}

.sortable-handle:active {
    cursor: grabbing;
}

/* ============================================
   Utility Classes
   ============================================ */
.text-primary { color: var(--primary); }
.text-secondary { color: var(--secondary); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-warning { color: var(--warning); }
.text-info { color: var(--info); }

.bg-primary { background: var(--primary); }
.bg-secondary { background: var(--secondary); }
.bg-success { background: var(--success); }
.bg-danger { background: var(--danger); }
.bg-warning { background: var(--warning); }
.bg-info { background: var(--info); }

.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }

.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }

.mr-xs { margin-right: var(--spacing-xs); }
.mr-sm { margin-right: var(--spacing-sm); }
.mr-md { margin-right: var(--spacing-md); }
.mr-lg { margin-right: var(--spacing-lg); }

.mt-auto { margin-top: auto; }
.mb-auto { margin-bottom: auto; }

.p-0 { padding: 0; }
.p-xs { padding: var(--spacing-xs); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }
.p-xl { padding: var(--spacing-xl); }

.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.gap-xs { gap: var(--spacing-xs); }
.gap-sm { gap: var(--spacing-sm); }
.gap-md { gap: var(--spacing-md); }
.gap-lg { gap: var(--spacing-lg); }

.hidden { display: none; }
.block { display: block; }
.inline-block { display: inline-block; }

.overflow-auto { overflow: auto; }
.overflow-hidden { overflow: hidden; }

.rounded-sm { border-radius: var(--radius-sm); }
.rounded-md { border-radius: var(--radius-md); }
.rounded-lg { border-radius: var(--radius-lg); }
.rounded-xl { border-radius: var(--radius-xl); }
.rounded-full { border-radius: var(--radius-full); }

.shadow-sm { box-shadow: var(--shadow-sm); }
.shadow { box-shadow: var(--shadow); }
.shadow-md { box-shadow: var(--shadow-md); }
.shadow-lg { box-shadow: var(--shadow-lg); }
.shadow-xl { box-shadow: var(--shadow-xl); }

.truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Scrollbar Styling */
::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

::-webkit-scrollbar-track {
    background: var(--gray-100);
    border-radius: var(--radius-full);
}

::-webkit-scrollbar-thumb {
    background: var(--gray-300);
    border-radius: var(--radius-full);
}

::-webkit-scrollbar-thumb:hover {
    background: var(--gray-400);
}

/* Selection */
::selection {
    background: var(--primary-lighter);
    color: var(--primary-dark);
}

/* Focus Visible */
:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
}

/* Disable text selection on buttons */
button {
    user-select: none;
}
